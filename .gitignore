# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.pytest_cache

# Everything under out/ is produced by the scripts. Trajectories, previews,
# videos and logs regenerate in seconds and pushed the repo past 250 MB.
#
# Exception: the two trajectories that are meant to be run on the real robot.
# They are committed so a clone has a ready-to-execute file without needing to
# re-plan first. Everything else stays out.
out/*
!out/.gitkeep
!out/arch_gen.json
!out/arch_gen.meta.json
!out/demo_gen.json
!out/demo_gen.meta.json

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Isaac Sim local artifacts
*.usd
*.usda
*.usdc
*.dmp

# Local temp
*.tmp
*.log

# Derived meshes: rebuilt by scripts/make_assets.py and scripts/align_brush.py
# from the tracked source PLY, so they stay out of version control.
/assets/tool/brushleap/brushleap.stl
/assets/tool/brushleap/brushleap_link6.stl
/assets/tool/brushleap/brushleap_link6_preview.ply
/assets/tool/brushleap/brushleap_preview.ply
/assets/tool/brushleap/faces.npy
/assets/robot/cr5a_with_tool/meshes/brushleap.stl
/assets/target/*_preview.ply
/assets/target/*.stl
